# Public base URL of this Oubliai server (no trailing slash).
OUBLIAI_BASE_URL=https://oubli-catolabs.fastmcp.app

# Single-tenant mode (Prefect Horizon / operator deployment):
# Set OUBLIAI_TELNYX_API_KEY plus either OUBLIAI_PLATFORM_AUTH=true (Horizon auth)
# or OUBLIAI_ACCESS_TOKEN (shared static bearer token, >=24 chars).
OUBLIAI_TELNYX_API_KEY=
OUBLIAI_PLATFORM_AUTH=true
OUBLIAI_ACCESS_TOKEN=

# Per-user OAuthProxy mode (required when OUBLIAI_TELNYX_API_KEY is unset):
OUBLIAI_TELNYX_CLIENT_ID=
OUBLIAI_TELNYX_CLIENT_SECRET=
OUBLIAI_JWT_SIGNING_KEY=
OUBLIAI_ALLOWED_CLIENT_REDIRECT_URIS=["https://claude.ai/api/mcp/auth_callback"]
OUBLIAI_STORAGE_ENCRYPTION_KEY=
OUBLIAI_STORAGE_URL=

# Optional path override for the canonical Telnyx OpenAPI 3.0 specification.
OUBLIAI_TELNYX_OPENAPI=

# Browser origins permitted to connect directly to /mcp via CORS (JSON list of exact origins).
OUBLIAI_BROWSER_ORIGINS=["http://localhost:3000"]

# FastMCP HTTP transport & Host/Origin protection settings.
FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8000
FASTMCP_HTTP_HOST_ORIGIN_PROTECTION=true
FASTMCP_HTTP_ALLOWED_HOSTS=["oubli-catolabs.fastmcp.app","localhost","127.0.0.1"]
FASTMCP_STATELESS_HTTP=false

# FastMCP background task (Docket) settings.
FASTMCP_DOCKET_URL=memory://
FASTMCP_DOCKET_NAME=oubliai-tasks
FASTMCP_DOCKET_WORKER_NAME=
FASTMCP_DOCKET_CONCURRENCY=
FASTMCP_TASKS_ENCRYPTION_KEY=

# Application Host & Facilitator settings (packages/app & server.ts)
OUBLIAI_DEV_CONNECTION=1
OUBLIAI_MCP_URL=https://oubli-catolabs.fastmcp.app/mcp
OUBLIAI_USER_TOKEN=
OUBLIAI_MODEL_BASE_URL=
OUBLIAI_MODEL_API_KEY=
OUBLIAI_MODEL_ID=