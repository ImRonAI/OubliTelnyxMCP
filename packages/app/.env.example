# Copy to .env locally and fill in. No values are committed.

# Deployed Oubliai MCP server URL (streamable HTTP endpoint, e.g. https://mcp.example.com/mcp)
OUBLIAI_MCP_URL=

# Per-user bearer token presented to the MCP server (BYOK; never an account key)
OUBLIAI_USER_TOKEN=

# Local/dev connection profile selector used by scripts and the host worker
OUBLIAI_DEV_CONNECTION=

# OpenAI-compatible model endpoint used by the application agent
OUBLIAI_MODEL_BASE_URL=

# API key for the model endpoint (stays server-side; never shipped to the browser)
OUBLIAI_MODEL_API_KEY=

# Model identifier passed to the endpoint
OUBLIAI_MODEL_ID=
