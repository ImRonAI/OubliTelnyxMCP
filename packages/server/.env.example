# Copy to .env locally and fill in. No values are committed. Every variable is read by
# `oubliai_server.__main__.create_server` / `run_options` or by FastMCP settings (see CLAUDE.md).
#
# Start browser-facing deployments with `python -m oubliai_server` (not `fastmcp run fastmcp.json`):
# only the module entry point can pass the CORS middleware configured by OUBLIAI_BROWSER_ORIGINS.

# --- Mode A: single-tenant demo (your own Telnyx account; one shared bearer for callers) ---
# When OUBLIAI_TELNYX_API_KEY is set, the OAuthProxy variables in Mode B are NOT required.
# Every caller holding OUBLIAI_ACCESS_TOKEN acts as this account. Never use for other people's accounts.
OUBLIAI_TELNYX_API_KEY=
# Random secret, >=24 chars: openssl rand -hex 24. MCP clients send it as the bearer token.
OUBLIAI_ACCESS_TOKEN=

# --- Mode B: per-user Telnyx login via OAuthProxy (required when Mode A is unset) ---
# Public base URL of this server; <OUBLIAI_BASE_URL>/auth/callback must be a redirect URI on the Telnyx OAuth client.
OUBLIAI_BASE_URL=https://mcp.example.com
# Telnyx OAuth client credentials (create via POST /v2/oauth_clients; schema path /oauth/clients is 404 live).
OUBLIAI_TELNYX_CLIENT_ID=
OUBLIAI_TELNYX_CLIENT_SECRET=
# Key used to sign the tokens this server issues to MCP clients.
OUBLIAI_JWT_SIGNING_KEY=
# JSON list of MCP-client redirect URIs allowed through dynamic client registration.
OUBLIAI_ALLOWED_CLIENT_REDIRECT_URIS=["https://claude.ai/api/mcp/auth_callback"]

# --- OAuthProxy client storage (required key, optional URL) ---
# Fernet key: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
OUBLIAI_STORAGE_ENCRYPTION_KEY=
# memory:// | file://<path> | redis://… | rediss://… ; unset = FileTreeStore (single instance only).
# Use redis for more than one replica.
OUBLIAI_STORAGE_URL=

# --- Host/Origin guard (required, must be in the process environment, not fastmcp.json) ---
FASTMCP_HTTP_HOST_ORIGIN_PROTECTION=true
FASTMCP_HTTP_ALLOWED_HOSTS=["mcp.example.com"]

# --- Browser hosts (optional) ---
# JSON list of exact origins allowed to call /mcp from a browser (the packages/app host, examples/embed).
# "*" is refused. FastMCP emits no CORS headers without this.
OUBLIAI_BROWSER_ORIGINS=["https://app.example.com"]

# --- Background tasks (optional) ---
# Default memory://. Any other Docket URL requires FASTMCP_TASKS_ENCRYPTION_KEY (task snapshots hold caller tokens).
FASTMCP_DOCKET_URL=
FASTMCP_TASKS_ENCRYPTION_KEY=

# --- Multi-worker / serverless (optional) ---
# Stateless HTTP (new transport per request) for horizontally scaled or serverless hosts; pair with redis storage above.
FASTMCP_STATELESS_HTTP=false

# --- Listener (optional; defaults 127.0.0.1:8000, path from fastmcp.json) ---
FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8000
